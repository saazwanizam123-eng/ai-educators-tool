/* ==========================================================================
   LIQUID GLASS DESIGN SYSTEM & ACCESSIBILITY STYLES
   ========================================================================== */
:root {
  --glass-bg: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
  --text-main: #0f172a;
  --accent-teal: #0d9488;
  --accent-glow: rgba(13, 148, 136, 0.6);
  --calligraphy-font: 'Great Vibes', cursive, serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

/* BACKGROUND IMAGE WITH OVERLAY */
body {
  min-height: 100vh;
  background: linear-gradient(rgba(15, 23, 42, 0.45), rgba(15, 23, 42, 0.45)), url('../assets/images/bg1.jpg') center/cover no-repeat fixed;
  color: #f8fafc;
  padding: 20px;
  transition: background 0.3s ease, color 0.3s ease;
}

/* High Contrast Mode Toggle Class */
body.high-contrast {
  background: #000000 !important;
  color: #ffff00 !important;
}

body.high-contrast .app-container,
body.high-contrast .glass-card {
  background: #000000 !important;
  border: 2px solid #ffff00 !important;
  box-shadow: none !important;
}

body.high-contrast .interactive-btn {
  background: #000000 !important;
  border: 2px solid #ffff00 !important;
  color: #ffff00 !important;
}

/* Container Glass Card */
.app-container {
  max-width: 1200px;
  margin: 0 auto;
  background: var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  box-shadow: var(--glass-shadow);
  padding: 30px;
  transition: opacity 0.8s ease-in-out;
}

/* IDLE MODE CLASS */
.app-container.idle-transparent {
  opacity: 0.15;
}

/* RAINBOW WAVE ANIMATED MAIN TITLE */
.image-heading {
  font-size: 2.8rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 20px;
  display: inline-block;
  background: linear-gradient(90deg, #ff4e50, #f9d423, #22c55e, #06b6d4, #3b82f6, #a855f7, #ff4e50);
  background-size: 300% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: rainbowWave 6s linear infinite;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.4s ease, font-family 0.3s ease;
  cursor: pointer;
}

@keyframes rainbowWave {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}

.image-heading:hover {
  font-family: var(--calligraphy-font);
  text-transform: none;
  transform: scale(1.08) translateY(-4px);
  filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.8)) drop-shadow(0 0 25px rgba(6, 182, 212, 0.8));
}

/* VIBRANT 3D CLAY TEXTURE SECTION HEADINGS */
.section-title {
  font-family: 'Fredoka', 'Segoe UI', sans-serif;
  font-size: 2.1rem;
  font-weight: 800;
  margin: 30px 0 15px 0;
  display: inline-block;
  letter-spacing: 0.5px;
  background: linear-gradient(180deg, #ffffff 0%, #38bdf8 45%, #0284c7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0px 2px 0px #0369a1)
          drop-shadow(0px 4px 0px #075985)
          drop-shadow(0px 6px 1px rgba(0, 0, 0, 0.4));
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s ease, font-family 0.3s ease;
  cursor: pointer;
}

.section-title:hover {
  font-family: var(--calligraphy-font);
  -webkit-text-fill-color: #ffffff;
  transform: scale(1.06) translateY(-2px);
  filter: drop-shadow(0 0 12px var(--accent-glow)) drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.5));
}

h3 {
  transition: font-family 0.3s ease, transform 0.3s ease;
  cursor: pointer;
}

h3:hover {
  font-family: var(--calligraphy-font);
  transform: scale(1.03);
}

/* INTERACTIVE BUTTONS */
.interactive-btn {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #ffffff;
  padding: 12px 24px;
  font-size: 1rem;
  font-weight: 700;
  border-radius: 12px;
  cursor: pointer;
  backdrop-filter: blur(6px);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.3s ease, box-shadow 0.3s ease, font-family 0.3s ease;
  outline: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.interactive-btn:hover {
  font-family: var(--calligraphy-font);
  font-size: 1.25rem;
  transform: scale(1.08) translateY(-2px);
  background: rgba(255, 255, 255, 0.3);
  box-shadow: 0 0 20px var(--accent-glow), 0 0 10px rgba(255, 255, 255, 0.5);
  border-color: #ffffff;
}

.interactive-btn:active {
  transform: scale(0.98);
}

.recording-active {
  background: rgba(239, 68, 68, 0.8) !important;
  border-color: #f87171 !important;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
  70% { box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}

/* LAYOUT & CARDS */
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
  margin-top: 20px;
}

@media (max-width: 850px) {
  .grid-2 { grid-template-columns: 1fr; }
}

.glass-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 16px;
  padding: 20px;
  backdrop-filter: blur(8px);
}

.accessibility-bar {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 20px;
  padding: 10px;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 12px;
}
